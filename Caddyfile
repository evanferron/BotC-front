# Sert le front et relaie /api (WebSocket compris) vers l'API, sur une seule origine : le cookie de
# rafraîchissement (SameSite=Strict) et le WebSocket fonctionnent sans CORS.
#
# Le HTTPS est assuré en amont (Tailscale Funnel ou autre reverse proxy) : Caddy ne parle que HTTP.
{
	auto_https off
	admin off
	servers {
		# Adresse du client transmise par le proxy HTTPS en amont (réseau local ou Tailscale)
		trusted_proxies static private_ranges 100.64.0.0/10
	}
}

:80 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# API REST et WebSocket temps réel (/api/ws) ; le Swagger n'est pas exposé
	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv

		# Fichiers au nom haché : jamais modifiés, gardés un an
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Tout le reste (index.html, service worker, manifeste) : revalidé à chaque visite, sinon
		# une nouvelle version de l'appli mettrait longtemps à arriver
		@fresh not path /assets/*
		header @fresh Cache-Control "no-cache"

		# Routes de l'appli (/parties/…) : servies par index.html
		try_files {path} /index.html
		file_server
	}
}
